executable            = run_tridentSample.sh

output                = out/tridentSample_signal_cutset8_$(ClusterId).$(ProcId).out
error                 = err/tridentSample_signal_cutset8_$(ClusterId).$(ProcId).err
log                   = log/tridentSample_signal_cutset8_$(ClusterId).log

getenv                = False
notification          = Never
requirements          = (OpSysAndVer =?= "AlmaLinux9")
